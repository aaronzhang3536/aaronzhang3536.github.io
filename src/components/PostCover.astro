---
import {postCover,type Post} from '../lib/posts';
interface Props {post:Post;eager?:boolean;decorative?:boolean;sizes?:string;}
const {post,eager=false,decorative=true,sizes='(max-width:700px) 90vw, 550px'}=Astro.props;
const cover=postCover(post);
---
{cover?<img class="post-cover-image" src={cover.src} srcset={`${cover.small} 480w, ${cover.src} 1440w`} sizes={sizes} width={cover.width} height={cover.height} alt={decorative?'':cover.alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async"/>:<span class="post-cover-fallback" aria-hidden="true"/>}
