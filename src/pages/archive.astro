---
import Studio from '../layouts/Studio.astro';
import Icon from '../components/Icon.astro';
import {getPosts,postUrl,postCategory,formatDate} from '../lib/posts';
const posts=await getPosts();
const years=[...new Set(posts.map(post=>post.data.date.getUTCFullYear()))];
---
<Studio title="文章归档"><main class="as-wrap as-page"><div class="gx-library-heading"><div><span class="gx-kicker">THE ARCHIVE</span><h1>按时间，慢慢翻。</h1><p>{posts.length} 篇文章，记录每一次理解与发现。</p></div><a class="gx-link" href="/notes/">图文浏览<Icon name="grid"/></a></div>{years.map(year=><section class="studio-archive-year"><h2>{year}</h2><div>{posts.filter(post=>post.data.date.getUTCFullYear()===year).map(post=><a href={postUrl(post)} class="studio-archive-row"><time datetime={formatDate(post.data.date)}>{formatDate(post.data.date).slice(5)}</time><span><strong>{post.data.title}</strong><small>{postCategory(post)}</small></span><span>{post.data.mins} min <Icon/></span></a>)}</div></section>)}</main></Studio>
