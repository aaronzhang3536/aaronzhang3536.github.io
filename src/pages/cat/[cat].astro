---
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import PostCollection from '../../components/PostCollection.astro';
import {getPosts,categories} from '../../lib/posts';
export async function getStaticPaths(){return categories.map(cat=>({params:{cat}}));}
const {cat}=Astro.params;
const posts=(await getPosts()).filter(post=>post.data.cat===cat);
---
<Studio title={cat} desc={`「${cat}」下的文章与记录。`}><main class="as-wrap as-page gx-library"><a class="as-back" href="/notes/"><Icon name="arrow-left"/>全部记录</a><div class="gx-library-heading"><div><span class="gx-kicker">COLLECTION</span><h1>{cat}</h1><p>{posts.length?`${posts.length} 篇文章，沿着这个方向深入。`:'这个主题还在慢慢积累。'}</p></div></div><PostCollection posts={posts} filters={false}/></main></Studio>
