---
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import PostCollection from '../../components/PostCollection.astro';
import {getPosts} from '../../lib/posts';
export async function getStaticPaths(){const posts=await getPosts();return [...new Set(posts.flatMap(post=>post.data.tags))].map(tag=>({params:{tag}}));}
const {tag}=Astro.params;
const posts=(await getPosts()).filter(post=>post.data.tags.includes(tag!));
---
<Studio title={`标签：${tag}`} desc={`「${tag}」相关的 ${posts.length} 篇文章。`}><main class="as-wrap as-page gx-library"><a class="as-back" href="/notes/"><Icon name="arrow-left"/>全部记录</a><div class="gx-library-heading"><div><span class="gx-kicker">CONNECTED NOTES</span><h1>#{tag}</h1><p>用一个关键词，把记录连起来。</p></div></div><PostCollection posts={posts} filters={false}/></main></Studio>
