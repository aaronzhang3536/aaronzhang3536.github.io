---
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import {render} from 'astro:content';
import {getPosts,postKind,postCategory,postExcerpt,postUrl,formatDate} from '../../lib/posts';
export async function getStaticPaths(){const posts=await getPosts();return posts.map((post,index)=>({params:{id:post.id},props:{post,older:posts[index+1]||null,newer:posts[index-1]||null,related:posts.filter(p=>p.id!==post.id&&(post.data.sub?p.data.sub===post.data.sub:p.data.cat===post.data.cat)).slice(0,3)}}));}
const {post,older,newer,related}=Astro.props;
const {Content,headings}=await render(post);
const toc=headings.filter(heading=>heading.depth>=2&&heading.depth<=3);
const hasToc=toc.length>=3;
const kind=postKind(post);
---
<Studio title={post.data.title} desc={postExcerpt(post)} type="article" published={post.data.date}>
<main class:list={['as-wrap','as-page','gx-reader',{'reader-with-toc':hasToc}]} data-reader>
  <a class="as-back" href="/notes/"><Icon name="arrow-left"/>所有记录</a>
  <div class="gx-article-hero" data-kind={kind}><div class="as-reader-heading"><a class="as-reader-label" href={`/cat/${encodeURIComponent(post.data.cat)}/`}>{postCategory(post)}</a><h1>{post.data.title}</h1><p class="as-reader-summary">{postExcerpt(post,72)}</p><div class="as-reader-meta"><span class="as-mini-avatar" aria-hidden="true">AZ</span><a href="/about/">Aaron Zhang</a><time datetime={formatDate(post.data.date)}>{formatDate(post.data.date).replaceAll('-','.')}</time><span>{post.data.mins} min</span><div class="as-reader-actions"><button type="button" data-bookmark={post.id} aria-pressed="false"><Icon name="bookmark"/><span data-bookmark-label>稍后读</span></button><button type="button" data-text-size aria-label="调整正文字号">A＋</button></div></div></div><div class="gx-reader-cover"><span class={`gx-image gx-image-${kind}`} aria-hidden="true"></span></div></div>
  <div class:list={['gx-reading-layout',{'studio-no-toc':!hasToc}]}><div class="reader-content"><article class="md-body as-reader-body"><Content/></article>
    {post.data.iframe&&<section class="studio-embedded"><a class="gx-link" href={post.data.iframe} target="_blank" rel="noopener">在独立页面打开<Icon/></a><iframe class="rd-frame" src={post.data.iframe} title={post.data.title} loading="lazy" allowfullscreen></iframe></section>}
    <div class="studio-post-tags" aria-label="文章标签">{post.data.tags.map(tag=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
    <nav class="studio-post-neighbors" aria-label="相邻文章">{older?<a href={postUrl(older)}><span>← 较早</span><strong>{older.data.title}</strong></a>:<span/>}{newer?<a href={postUrl(newer)}><span>较新 →</span><strong>{newer.data.title}</strong></a>:<span/>}</nav>
    {related.length>0&&<section class="studio-related"><h2>沿着这个主题，继续读。</h2><div class="studio-related-list">{related.map(item=><PostCard post={item} mode="story"/>)}</div></section>}
    <section class="cmt studio-comments" id="cmt"><h2>讨论</h2><div id="cmt-box"></div><noscript><p>评论需要 JavaScript。也可以前往<a href="https://github.com/aaronzhang3536/aaronzhang3536.github.io/discussions" target="_blank" rel="noopener">GitHub Discussions</a>。</p></noscript></section>
  </div>
  {hasToc&&<aside class="as-outline toc-sidebar" id="article-outline"><nav class="toc" aria-label="文章目录"><details class="toc-disclosure"><summary class="toc-t"><span>篇内目录</span><Icon name="chevron"/></summary><ul class="toc-links">{toc.map(heading=><li class={`d${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></details></nav><div class="gx-reader-side-note"><span>换一个角度</span><a class="gx-link" href="/play/">去做点好玩的<Icon/></a></div></aside>}
  </div>
  <nav class="studio-reading-shortcuts" data-reading-shortcuts aria-label="阅读快捷入口" hidden>{hasToc&&<a href="#article-outline" data-show-outline>目录</a>}<a href="#studio-header" aria-label="返回顶部">↑ 顶部</a></nav>
</main></Studio>
<script>import '../../scripts/article-toc.js';import '../../scripts/comments.js';</script>
