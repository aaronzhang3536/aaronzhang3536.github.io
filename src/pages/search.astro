---
import Studio from '../layouts/Studio.astro';
import Icon from '../components/Icon.astro';
---
<Studio title="搜索" desc="搜索一帧之内的文章标题、标签与完整正文。">
<main class="as-wrap as-page studio-search"><div class="as-page-head"><div class="as-eyebrow">FIND A NOTE</div><h1>找一篇内容。</h1><p>搜标题、标签，或者正文里记得的一句话。</p></div><form class="as-search-field" role="search" action="/search/"><Icon name="search"/><input type="search" name="q" data-search-input aria-label="搜索关键词" placeholder="MegaLights、Nanite、蒙特卡洛…" autocomplete="off"/><button type="submit" aria-label="搜索"><Icon name="arrow-right"/></button></form><p data-search-status class="studio-search-status" aria-live="polite">正在准备搜索…</p><button type="button" class="as-solid" data-search-retry hidden>重新加载搜索</button><div data-search-results class="studio-search-results"></div><noscript><p class="studio-empty">搜索需要 JavaScript。你也可以直接浏览<a href="/notes/">全部文章</a>或<a href="/archive/">文章归档</a>。</p></noscript></main>
</Studio>
<script>import '../scripts/search.js';</script>
