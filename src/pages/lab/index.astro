---
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import {experiments} from '../../lib/experiments';
---
<Studio title="图形实验室" desc="可以在浏览器中亲手体验的渲染、几何、物理与体系结构实验。"><main class="as-wrap as-page"><a class="as-back" href="/play/"><Icon name="arrow-left"/>做点好玩的</a><div class="gx-library-heading"><div><span class="gx-kicker">THE PLAYGROUND</span><h1>把原理，变成实验。</h1><p>粒子、光照、几何与物理。选择一个方向，亲手观察。</p></div></div><div class="studio-lab-list">{experiments.filter(item=>item.live).map((item,index)=><a href={item.href}><span class="studio-lab-index">{String(index+1).padStart(2,'0')}</span><span><h2>{item.name}</h2><p>{item.desc}</p></span><span class="studio-lab-tag">{item.tag}<Icon/></span></a>)}</div></main></Studio>
